<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground. The launcher renders the foreground at
    108dp x 108dp but only guarantees that the central 66dp x 66dp
    "safe zone" stays visible after masking (circle, squircle, …).

    ic_launcher_btc.png is the user-supplied bitcoin logo and would,
    placed bare, fill the entire 108dp area — the orange ring would
    touch the edges and get clipped on most launcher masks. Wrapping
    it in a layer-list with insets ~16dp pulls the artwork into the
    safe zone so the full ring is always visible.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:drawable="@drawable/ic_launcher_btc"
        android:left="16dp"
        android:top="16dp"
        android:right="16dp"
        android:bottom="16dp" />
</layer-list>
