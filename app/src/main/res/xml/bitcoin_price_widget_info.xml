<?xml version="1.0" encoding="utf-8"?>
<!--
    `android:widgetFeatures="reconfigurable"` is what makes the pencil
    icon appear when the user is moving / repositioning the widget on
    their home screen (Android 12+). Tapping it relaunches the configure
    activity, which detects "this widget already has settings saved" and
    pre-fills the existing choices.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="org.cheeserobot.btcwidget.WidgetConfigActivity"
    android:description="@string/widget_description"
    android:initialKeyguardLayout="@layout/widget_bitcoin_price"
    android:initialLayout="@layout/widget_bitcoin_price"
    android:minWidth="140dp"
    android:minHeight="60dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewImage="@drawable/ic_bitcoin"
    android:previewLayout="@layout/widget_bitcoin_price"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable" />
