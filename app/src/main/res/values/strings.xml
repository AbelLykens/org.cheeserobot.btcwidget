    <string name="preview_error_server">Server error</string>
    <string name="preview_error_server_detail">cheeserobot.org didn\'t answer with a price. Try again in a moment.</string>
    <string name="preview_error_fetch_failed">Couldn\'t fetch price</string>
    <string name="preview_error_fetch_failed_detail">%1$s</string>
