<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Cheese BTC Widget</string>
    <string name="widget_label">BTC Price</string>
    <string name="widget_description">Shows the latest Bitcoin price from cheeserobot.org</string>

    <!-- Configuration screen -->
    <string name="config_currency_label">Currency</string>
    <string name="config_usd">US Dollars ($)</string>
    <string name="config_eur">Euros (€)</string>
    <string name="config_btc">Bitcoin (₿) — always 1 BTC</string>
    <string name="config_sats">Sats per USD</string>
    <string name="config_block">Block height — latest block</string>

    <string name="config_preview_label">Preview</string>

    <string name="config_advanced_show">Advanced options ▾</string>
    <string name="config_advanced_hide">Advanced options ▴</string>

    <string name="config_tracked_amount_label">Tracked amount</string>
    <string name="config_tracked_amount_hint">1</string>
    <string name="config_tracked_amount_hint_long">How much BTC to price. e.g. 0.5 shows half a Bitcoin\'s worth. Default: 1.</string>

    <string name="config_format_label">Number format</string>
    <string name="config_show_decimals">Show decimal places</string>
    <string name="config_separator_label">Thousands separator</string>
    <string-array name="config_separator_options">
        <item>Auto (locale)</item>
        <item>Comma — 1,234</item>
        <item>Dot — 1.234</item>
        <item>Space — 1 234</item>
        <item>None — 1234</item>
    </string-array>

    <!--
        Easter-egg toggle. The CheckBox is only revealed when currency
        is SATS and a thousands separator is in use; the copy itself
        is the wink — picking it formats the four-digit sats value as
        a colon-split clock (e.g. 1234 → 12:34).
    -->
    <string name="config_moscow_time">Display as Moscow Time</string>

    <string name="config_opacity_label">Background opacity</string>
    <string name="config_opacity_value">%1$d%%</string>

    <string name="config_display_label">Display</string>
    <!--
        Display toggles read in the affirmative ("Show X") and are
        checked by default when the corresponding feature is visible
        out of the box. The underlying SharedPreferences keys still
        store the *hide* boolean — the UI inverts at bind/save time —
        so existing widgets that already saved a hide=true value keep
        rendering identically without a migration step.
    -->
    <string name="config_show_logo">Show Bitcoin logo</string>
    <string name="config_show_currency_icon">Show currency icon ($, €, sat)</string>
    <string name="config_show_unit_label">Show \"1 BTC\" caption</string>
    <!--
        BLOCK mode reuses the same caption slot as the "1 BTC" toggle but
        the slot now carries the miner / pool name, so the label is
        relabeled at bind time when the user picks Block height.
    -->
    <string name="config_show_miner_name">Show miner name</string>
    <string name="config_show_chart">Show chart background</string>
    <string name="config_show_chart_hint">Paint a faint price line behind the widget. The chart spans the same period chosen below.</string>

    <!--
        Price-text colour swatches. The first option ("Default") clears
        any override and falls back to the theme colour (dark text in
        light mode, light text in dark mode). All other swatches paint
        the price in the literal hue regardless of theme.
    -->
    <string name="config_price_color_label">Price text color</string>
    <string name="config_price_color_default">Default</string>
    <string name="config_price_color_default_desc">Use theme color (default)</string>
    <string name="config_price_color_black_desc">Black</string>
    <string name="config_price_color_white_desc">White</string>
    <string name="config_price_color_orange_desc">Bitcoin orange</string>
    <string name="config_price_color_red_desc">Red</string>
    <string name="config_price_color_green_desc">Green</string>
    <string name="config_price_color_blue_desc">Blue</string>

    <!--
        Custom backend URL. Lets advanced users point the widget at their
        own price feed (e.g. a self-hosted pricemon instance). Default
        URL is pre-filled, the field auto-validates when the user finishes
        typing, and a reset button restores the bundled default in one
        tap. Stored globally because all widgets share the same fetch.
    -->
    <string name="config_backend_label">Price backend</string>
    <string name="config_backend_hint">https://example.com/summary.json</string>
    <string name="config_backend_help">Advanced: point the widget at your own price feed. The format must match the default backend (price, hist_1d, hist_7d, latest_block). Compatible with %1$s.</string>
    <string name="config_backend_pricemon_link">pricemon</string>
    <string name="config_backend_pricemon_url">https://github.com/AbelLykens/pricemon</string>
    <string name="config_backend_reset">Reset to default URL</string>
    <string name="config_backend_status_idle"></string>
    <string name="config_backend_status_validating">Checking backend…</string>
    <string name="config_backend_status_valid">Saved — using your custom backend.</string>
    <string name="config_backend_status_default">Using the default backend.</string>
    <string name="config_backend_status_invalid">Not saved: %1$s</string>

    <string name="config_change_label">Price change</string>
    <string name="config_change_hint">Pick the time window. The percentage line at the bottom reads in this period (green up / red down) and the optional chart background covers the same span.</string>
    <string name="config_change_1d">24h</string>
    <string name="config_change_1w">7d</string>

    <!--
        config_save / config_cancel are kept around in case any reused
        layout references them, but the live config screen now uses the
        single "Done" action below and auto-saves on every close path.
    -->
    <string name="config_save">Save</string>
    <string name="config_cancel">Cancel</string>
    <string name="config_done">Done</string>
    <string name="config_autosave_hint">Changes save automatically when you close this screen.</string>

    <string name="config_version_label">Version %1$s</string>

    <string name="btc_icon_desc">Bitcoin logo</string>
    <string name="sat_icon_desc">Sat symbol</string>

    <!-- Battery saver dialog (BatterySaverInfoActivity) -->
    <string name="battery_saver_dialog_title">Battery saver is on</string>
    <string name="battery_saver_dialog_message">The Bitcoin price widget won\'t auto-update right now to save power. Tapping it won\'t fetch a new price either. Turn off battery saver to resume live updates.</string>
    <string name="battery_saver_dialog_open_settings">Battery settings</string>
    <string name="battery_saver_dialog_dismiss">OK</string>

    <!-- Launcher screen -->
    <string name="launcher_subtitle">Live BTC price on your home screen</string>
    <string name="preview_loading">Checking price feed…</string>
