    <string name="block_miner_unknown">Unknown miner</string>
    <string name="launcher_how_to_title">How to add the widget</string>
    <string name="launcher_how_to_steps">1.  Long-press an empty spot on your home screen.\n2.  Tap \"Widgets\".\n3.  Find \"Cheese BTC Widget\" in the list.\n4.  Drag \"BTC Price\" onto the home screen.\n5.  Choose USD or EUR.</string>
    <string name="launcher_add_widget">Add widget to home screen</string>
    <string name="launcher_open_home">Take me to the home screen</string>
    <string name="launcher_refresh_all">Refresh existing widgets</string>
