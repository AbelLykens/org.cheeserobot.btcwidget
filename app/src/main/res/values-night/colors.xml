<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark surface; the widget runtime controls alpha. -->
    <color name="widget_background">#BF202124</color>
    <color name="widget_background_solid">#FF202124</color>
    <color name="widget_text">#FFEDEDED</color>
    <color name="bitcoin_orange">#FFF7931A</color>

    <!-- Slightly brighter green/red for legibility on dark backgrounds. -->
    <color name="change_up">#FF4CD964</color>
    <color name="change_down">#FFFF6B6B</color>

    <!--
        Sparkline on dark wallpaper at low alpha needs to start from
        a much brighter base hue, otherwise the dark green/red of the
        light theme blends into the background and the chart looks
        like nothing was drawn at all.
    -->
    <color name="sparkline_up">#FF4CD964</color>
    <color name="sparkline_down">#FFFF6B6B</color>
</resources>
