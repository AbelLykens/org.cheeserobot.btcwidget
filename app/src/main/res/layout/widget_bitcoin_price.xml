<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout structure:

      FrameLayout (widget_root, transparent)
        ├─ ImageView (background_view) — fills root, runtime opacity
        └─ LinearLayout (vertical, fills root)
             ├─ LinearLayout (content_row, weight=1, centered horiz.)
             │     ├─ ImageView (btc_icon)   — orange logo
             │     └─ LinearLayout (text_column)
             │          ├─ unit_label (e.g. "1 BTC")
             │          └─ price_text (e.g. "$ 81,282")
             └─ TextView (change_indicator) — small red/green % line,
                                              GONE unless the user enabled
                                              the indicator in settings
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!--
        Vertical column: content_row (weight=1) + change_indicator
        (wrap_content). When the indicator is GONE, content_row gets
        the full height — same look as before. When it's VISIBLE,
        content_row shrinks slightly to make room.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/content_row"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp">

            <ImageView
                android:id="@+id/btc_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/btc_icon_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bitcoin" />

            <LinearLayout
                android:id="@+id/text_column"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:minWidth="120dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/unit_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/widget_text"
                    android:textSize="11sp"
                    tools:text="1 BTC" />

                <!--
                    price_text uses 0dp + weight=1 so it inherits a bounded
                    height from text_column (match_parent). Auto-sizing
                    needs that bound; with wrap_content it can't decide how
                    big to grow and just settles on something modest.
                -->
                <TextView
                    android:id="@+id/price_text"
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="40sp"
                    android:autoSizeMinTextSize="14sp"
                    android:autoSizeStepGranularity="1sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="120dp"
                    android:textColor="@color/widget_text"
                    android:textStyle="bold"
                    tools:text="$ 81,282" />
            </LinearLayout>
        </LinearLayout>

        <!--
            Optional red/green percentage-change line. The provider sets
            text + textColor + visibility at runtime based on the user's
            change-indicator preference.
        -->
        <TextView
            android:id="@+id/change_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+1.5% 24h"
            tools:textColor="@color/change_up"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
