<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout structure:

      FrameLayout (root, transparent)
        ├─ ImageView (background_view) — fills root, used to control
        │                                background opacity at runtime via
        │                                setImageAlpha (RemoteViews can't
        │                                tint shape drawables directly)
        └─ LinearLayout (content)
             ├─ ImageView (btc_icon)    — orange logo, can be hidden /
             │                            greyed out at runtime
             └─ LinearLayout (text_column)
                  ├─ "1 BTC"            — small caption: makes it explicit
                  │                       we always show price for one BTC
                  └─ price_text          — auto-sizing big number
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <LinearLayout
        android:id="@+id/content_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp">

        <ImageView
            android:id="@+id/btc_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/btc_icon_desc"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_bitcoin" />

        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unit_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alpha="0.75"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="11sp"
                tools:text="1 BTC" />

            <TextView
                android:id="@+id/price_text"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                tools:text="$78,875" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
