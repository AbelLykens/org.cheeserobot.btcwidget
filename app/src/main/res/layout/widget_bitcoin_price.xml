<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout structure:

      FrameLayout (widget_root, transparent)
        ├─ ImageView (background_view) — fills root, runtime opacity
        ├─ ImageView (sparkline_view)  — fills root, NO opacity slider
        └─ LinearLayout (vertical, fills root)
             ├─ TextView (unit_label)        — small "1 BTC" caption
             ├─ LinearLayout (content_row)   — icon + price, weight=1
             │     ├─ ImageView (btc_icon)
             │     └─ TextView (price_text)  — auto-sized
             └─ TextView (change_indicator)  — small red/green % line

    Why two background ImageViews? The opacity slider must dim the
    rounded panel (background_view) without dimming the sparkline.
    Keeping them in separate ImageViews lets us call setImageAlpha
    on background_view alone — sparkline_view stays fully visible
    even at 0% panel opacity, exactly when the user wants the chart
    to read against their wallpaper directly.

    Why unit_label is a SIBLING of content_row (not nested next to
    price_text in a column): putting it as a sibling above lets the
    inner horizontal row centre the bitcoin glyph and the price number
    on the same vertical axis. With a vertical column wrapping the
    text only, the icon's centre would land *between* the unit caption
    and the price number rather than next to the number itself.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/background_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/widget_background" />

    <!--
        Sparkline lives on its OWN ImageView so the opacity slider
        (which sets background_view's imageAlpha) doesn't fade the
        chart out. At 0% panel opacity the line still reads against
        the user's wallpaper.
    -->
    <ImageView
        android:id="@+id/sparkline_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- "1 BTC" caption above the icon+price row. -->
        <TextView
            android:id="@+id/unit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0.7"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingTop="4dp"
            android:textColor="@color/widget_text"
            android:textSize="11sp"
            tools:text="1 BTC" />

        <!--
            content_row centres icon and price_text on the same vertical
            line. content_row itself has weight=1 so it eats whatever
            vertical space is left after unit_label and change_indicator.
        -->
        <LinearLayout
            android:id="@+id/content_row"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/btc_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/btc_icon_desc"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bitcoin" />

            <!--
                price_text uses height=match_parent so auto-sizing has a
                bounded vertical extent (the row height that the outer
                weighted layout has resolved). minWidth gives it a sane
                horizontal floor so very short numbers don't shrink to
                nothing.
            -->
            <TextView
                android:id="@+id/price_text"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:autoSizeMaxTextSize="40sp"
                android:autoSizeMinTextSize="14sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:minWidth="120dp"
                android:textColor="@color/widget_text"
                android:textStyle="bold"
                tools:text="$ 81,282" />
        </LinearLayout>

        <!--
            Optional red/green percentage-change line. The provider sets
            text + textColor + visibility at runtime based on the user's
            change-indicator preference.
        -->
        <TextView
            android:id="@+id/change_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:paddingBottom="4dp"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="+1.5% 24h"
            tools:textColor="@color/change_up"
            tools:visibility="visible" />
    </LinearLayout>
</FrameLayout>
