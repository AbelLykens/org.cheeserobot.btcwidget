<?xml version="1.0" encoding="utf-8"?>
<!--
    Two-tier settings: the simple/default screen shows just the currency
    picker. Tapping the "Advanced options" header expands the rest of the
    knobs (tracked amount, formatting, opacity, display toggles, change
    indicator). For reconfigure flows where any advanced setting is
    non-default, the activity auto-expands the section on entry so the
    user can see what's already set.

    Layout shape:
      LinearLayout (vertical, fills the screen)
        ├─ STICKY HEADER (no scroll): icon, title, subtitle, preview.
        │   The preview stays visible at the top of the screen while the
        │   user scrolls through the controls so every setting change has
        │   immediate visual feedback without scroll-juggling.
        └─ ScrollView (weight=1, takes remaining vertical space)
              └─ All currency / advanced / action controls live here.

    The preview's wrapping FrameLayout gets a checkered grey background
    at runtime so the user can see how their chosen opacity reads against
    any home-screen wallpaper.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ================================================================
         Sticky header. Trimmed down to just the logo + preview so the
         scrollable controls below get more breathing room. The title /
         subtitle TextViews used to live here ("Choose your currency",
         "Update your widget settings"); they were decorative and pushed
         the preview further down on small screens, so they're gone now.
         ================================================================ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginBottom="6dp"
            android:contentDescription="@string/btc_icon_desc"
            android:src="@drawable/ic_bitcoin" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/config_preview_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <FrameLayout
            android:id="@+id/preview_container"
            android:layout_width="match_parent"
            android:layout_height="100dp">

            <include layout="@layout/widget_bitcoin_price" />
        </FrameLayout>
    </LinearLayout>

    <!-- ================================================================
         Scrollable controls. weight=1 makes this view absorb every
         pixel of vertical space the sticky header didn't claim.
         fillViewport keeps short content centred when the screen is
         taller than the controls themselves.
         ================================================================ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- ============================================================
                 Simple section — currency only. Always visible.
                 ============================================================ -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/config_currency_label"
                android:textSize="13sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/rg_currency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/rb_usd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_usd" />

                <RadioButton
                    android:id="@+id/rb_eur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_eur" />

                <RadioButton
                    android:id="@+id/rb_btc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_btc" />

                <RadioButton
                    android:id="@+id/rb_sats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_sats" />

                <RadioButton
                    android:id="@+id/rb_block"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_block" />
            </RadioGroup>

            <!-- ============================================================
                 Advanced toggle. Tapping flips the visibility of
                 advanced_section below and updates this caret.
                 ============================================================ -->
            <TextView
                android:id="@+id/advanced_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="44dp"
                android:paddingVertical="10dp"
                android:text="@string/config_advanced_show"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/advanced_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!--
                    Tracked amount group. Hidden for BLOCK mode because
                    "0.5 of a block height" makes no sense.
                -->
                <LinearLayout
                    android:id="@+id/group_tracked_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/config_tracked_amount_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_tracked_amount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:autofillHints="@null"
                        android:hint="@string/config_tracked_amount_hint"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="16"
                        tools:text="1" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:alpha="0.7"
                        android:text="@string/config_tracked_amount_hint_long"
                        android:textSize="12sp" />
                </LinearLayout>

                <!--
                    Number-format group. Hidden for BLOCK mode — block
                    heights don't need a user-pickable separator.
                -->
                <LinearLayout
                    android:id="@+id/group_number_format"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/config_format_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/config_separator_label"
                            android:textSize="13sp" />

                        <Spinner
                            android:id="@+id/sp_separator"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="160dp" />
                    </LinearLayout>
                </LinearLayout>

                <!--
                    Easter-egg "Moscow Time" toggle. Hidden by default; the
                    activity flips visibility based on currency==SATS AND
                    a thousands separator being in use. The wink in the
                    copy is intentional — anyone who recognises the meme
                    will know what they're enabling.
                -->
                <CheckBox
                    android:id="@+id/cb_moscow_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-8dp"
                    android:layout_marginBottom="20dp"
                    android:text="@string/config_moscow_time"
                    android:visibility="gone" />

                <!-- Background opacity -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/config_opacity_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/opacity_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        tools:text="75%" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/sb_opacity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:max="100" />

                <!--
                    Display toggles. All read in the affirmative ("Show X")
                    and are checked by default whenever the corresponding
                    feature is visible out of the box. The activity inverts
                    each binding against the underlying KEY_HIDE_* prefs at
                    load/save time so on-disk semantics don't change.
                -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/config_display_label"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cb_show_logo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_show_logo" />

                <!--
                    Currency marker:
                      - USD/EUR/BTC: the "$" / "€" / "₿" prefix on the
                        price text.
                      - SATS: the sat-symbol icon (in SATS mode the icon
                        slot doubles as the currency marker, so this
                        composes with "Show Bitcoin logo" — either being
                        unchecked hides the icon).
                -->
                <CheckBox
                    android:id="@+id/cb_show_currency_icon"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_show_currency_icon" />

                <CheckBox
                    android:id="@+id/cb_show_unit_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_show_unit_label" />

                <CheckBox
                    android:id="@+id/cb_show_decimals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_show_decimals" />

                <CheckBox
                    android:id="@+id/cb_show_chart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/config_show_chart" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:alpha="0.7"
                    android:text="@string/config_show_chart_hint"
                    android:textSize="12sp" />

                <!--
                    Price text colour. Tap a swatch to set; the leftmost
                    "A" swatch is the theme default (dark in light mode /
                    light in dark mode). The activity paints each swatch
                    programmatically (filled circle) and overlays a
                    selection ring on the active one.
                -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/config_price_color_label"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/color_picker_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:id="@+id/color_swatch_default"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_default_desc"
                            android:focusable="true"
                            android:clickable="true">

                            <TextView
                                android:id="@+id/color_swatch_default_label"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:text="@string/config_price_color_default"
                                android:textSize="10sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <View
                            android:id="@+id/color_swatch_black"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_black_desc"
                            android:focusable="true"
                            android:clickable="true" />

                        <View
                            android:id="@+id/color_swatch_white"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_white_desc"
                            android:focusable="true"
                            android:clickable="true" />

                        <View
                            android:id="@+id/color_swatch_orange"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_orange_desc"
                            android:focusable="true"
                            android:clickable="true" />

                        <View
                            android:id="@+id/color_swatch_red"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_red_desc"
                            android:focusable="true"
                            android:clickable="true" />

                        <View
                            android:id="@+id/color_swatch_green"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@string/config_price_color_green_desc"
                            android:focusable="true"
                            android:clickable="true" />

                        <View
                            android:id="@+id/color_swatch_blue"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/config_price_color_blue_desc"
                            android:focusable="true"
                            android:clickable="true" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!--
                    Price change. Drives BOTH the bottom red/green percentage
                    line AND, when "Show chart background" above is on, the
                    period covered by the sparkline (24h or 7d). Hidden
                    for BTC mode (always 1 BTC) and BLOCK mode (height
                    only ever climbs).
                -->
                <LinearLayout
                    android:id="@+id/group_price_change"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:text="@string/config_change_label"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:alpha="0.7"
                        android:text="@string/config_change_hint"
                        android:textSize="12sp" />

                    <RadioGroup
                        android:id="@+id/rg_change"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/rb_change_1d"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/config_change_1d" />

                        <RadioButton
                            android:id="@+id/rb_change_1w"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/config_change_1w" />
                    </RadioGroup>
                </LinearLayout>

                <!--
                    Custom price backend. Pre-filled with the bundled
                    default; the activity revalidates whenever the field
                    loses focus or the user taps Reset. Successful
                    validation saves immediately to a GLOBAL pref (every
                    placed widget shares one fetch, so a custom backend
                    is an app-wide setting even though the UI lives here).
                -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/config_backend_label"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/et_backend_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:autofillHints="@null"
                    android:hint="@string/config_backend_hint"
                    android:importantForAutofill="no"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="2"
                    tools:text="https://price.cheeserobot.org/price/summary.json" />

                <TextView
                    android:id="@+id/tv_backend_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:alpha="0.85"
                    android:textSize="12sp"
                    tools:text="Using the default backend." />

                <Button
                    android:id="@+id/btn_backend_reset"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/config_backend_reset" />

                <TextView
                    android:id="@+id/tv_backend_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:alpha="0.7"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:textSize="12sp"
                    tools:text="Advanced: point the widget at your own feed. Compatible with pricemon (https://github.com/AbelLykens/pricemon)." />
            </LinearLayout>

            <!--
                Single "Done" action. Settings auto-save when the
                activity finishes (Done button, system back button, or
                swipe-back gesture all run the same persist+update path
                via the overridden Activity.finish() in WidgetConfigActivity).
                The hint below the button reassures the user that nothing
                is lost on back-out.
            -->
            <Button
                android:id="@+id/btn_done"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/config_done" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:alpha="0.7"
                android:gravity="center"
                android:text="@string/config_autosave_hint"
                android:textSize="12sp" />

            <!-- Version footer — populated at runtime from PackageInfo. -->
            <TextView
                android:id="@+id/version_footer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:alpha="0.5"
                android:gravity="center"
                android:textSize="11sp"
                tools:text="Version 1.0" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
