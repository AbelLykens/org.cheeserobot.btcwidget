<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/btc_icon_desc"
            android:src="@drawable/ic_bitcoin" />

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/config_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/subtitle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="@string/config_subtitle"
            android:textSize="14sp" />

        <!-- Currency picker -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/config_currency_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rg_currency"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rb_usd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_usd" />

            <RadioButton
                android:id="@+id/rb_eur"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_eur" />

            <RadioButton
                android:id="@+id/rb_btc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/config_btc" />
        </RadioGroup>

        <!-- Tracked amount -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/config_tracked_amount_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/et_tracked_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:hint="@string/config_tracked_amount_hint"
            android:inputType="numberDecimal"
            android:maxLength="16"
            android:autofillHints="@null"
            android:importantForAutofill="no"
            tools:text="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:alpha="0.7"
            android:text="@string/config_tracked_amount_hint_long"
            android:textSize="12sp" />

        <!-- Number formatting -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/config_format_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_show_decimals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_show_decimals" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_separator_label"
                android:textSize="13sp" />

            <Spinner
                android:id="@+id/sp_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="160dp" />
        </LinearLayout>

        <!-- Background opacity -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/config_opacity_label"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/opacity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                tools:text="75%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/sb_opacity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:max="100" />

        <!-- Display toggles -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/config_display_label"
            android:textSize="13sp"
            android:textStyle="bold" />

        <CheckBox
            android:id="@+id/cb_hide_logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_hide_logo" />

        <CheckBox
            android:id="@+id/cb_hide_unit_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="@string/config_hide_unit_label" />

        <!-- Action buttons -->
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/config_save" />

        <Button
            android:id="@+id/btn_cancel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_cancel" />
    </LinearLayout>
</ScrollView>
