<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CheeseWidget">

        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.CheeseWidget">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Note: we deliberately do NOT register for
            ACTION_POWER_SAVE_MODE_CHANGED here. Android tags that
            broadcast with FLAG_RECEIVER_REGISTERED_ONLY, which means
            manifest receivers never get it — only dynamically registered
            ones do. Live battery-saver detection happens inside
            BatterySaverInfoActivity instead.
        -->
        <receiver
            android:name=".BitcoinPriceWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="org.cheeserobot.btcwidget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/bitcoin_price_widget_info" />
        </receiver>

        <activity
            android:name=".WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.CheeseWidget.Config">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            Translucent activity used as the widget's tap-target whenever
            battery saver is active. We can't surface a Toast from the
            BroadcastReceiver context (Android suppresses background
            toasts when notifications are disabled), so we open a tiny
            dialog activity instead.
        -->
        <activity
            android:name=".BatterySaverInfoActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.CheeseWidget.Transparent" />

    </application>

</manifest>
